\\u0431\\u0438\\u043B\\u0435\\u0442\\u044B, \\u043F\\u0440\\u0438\\u043D\\u0438\\u043C\\u0430\\u0442\\u044C \\u0443\\u0447\\u0430\\u0441\\u0442\\u0438\\u0435 \\u0432 \\u043E\\u0440\\u0433\\u0430\\u043D\\u0438\\u0437\\u043E\\u0432\\u0430\\u043D\\u043D\\u044B\\u0445 \\u0440\\u043E\\u0437\\u044B\\u0433\\u0440\\u044B\\u0448\\u0430\\u0445 \\u0438 \\u0440\\u0435\\u043A\\u043B\\u0430\\u043C\\u0438\\u0440\\u043E\\u0432\\u0430\\u0442\\u044C \\u043B\\u043E\\u0442\\u0435\\u0440\\u0435\\u0439\\u043D\\u044B\\u0435 \\u043F\\u0440\\u043E\\u0434\\u0443\\u043A\\u0442\\u044B.\"}),/*#__PURE__*/_jsx(\"br\",{}),/*#__PURE__*/_jsx(\"br\",{}),/*#__PURE__*/_jsx(\"span\",{children:\"\\uD83D\\uDCE5 \\u041F\\u043E\\u0434\\u0430\\u0442\\u044C \\u0437\\u0430\\u044F\\u0432\\u043A\\u0443 \\u043D\\u0430 \\u043F\\u043E\\u043B\\u0443\\u0447\\u0435\\u043D\\u0438\\u0435 \\u043B\\u0438\\u0446\\u0435\\u043D\\u0437\\u0438\\u0438 \\u0438 \\u043E\\u0437\\u043D\\u0430\\u043A\\u043E\\u043C\\u0438\\u0442\\u044C\\u0441\\u044F \\u0441 \\u043F\\u043E\\u043B\\u043D\\u044B\\u043C \\u0442\\u0435\\u043A\\u0441\\u0442\\u043E\\u043C \\u0423\\u043A\\u0430\\u0437\\u0430 \\u2116 \\u0423\\u041F-68 \\u043C\\u043E\\u0436\\u043D\\u043E \\u043D\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 my.gov.uz.\"})]})})})})})});};ContentList1.defaultProps={text:undefined};export default ContentList1;","map":{"version":3,"names":["React","Fragment","jsx","_jsx","jsxs","_jsxs","ContentList1","props","_props$text","className","children","text","defaultProps","undefined"],"sources":["C:/Users/VL/YandexDisk/Site/Goldbet-UZ/goldbet_react/src/components/content-list1.js"],"sourcesContent":["import React, { Fragment } from 'react'\n\nimport PropTypes from 'prop-types'\n\nimport './content-list1.css'\n\nconst ContentList1 = (props) => {\n  return (\n    <div className=\"content-list1-container thq-section-padding\">\n      <div className=\"content-list1-max-width thq-section-max-width\">\n        <div className=\"content-list1-content thq-flex-column\">\n          <span>\n            {props.text ?? (\n              <Fragment>\n                <span className=\"content-list1-text11\">\n                  <span>\n                    Порядок получения лицензии на лотерейную деятельность\n                  </span>\n                  <br></br>\n                  <span>\n                    В соответствии с Указом Президента Республики Узбекистан\n                    Шавката Мирзиёева № УП-68 от 19 апреля 2024 года, в стране\n                    введены обновлённые правила регулирования и лицензирования\n                    лотерейной деятельности. Целью указа является повышение\n                    прозрачности, обеспечение честности и развитие цифровых\n                    форматов в сфере лотерей.\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>Кто может получить лицензию?</span>\n                  <br></br>\n                  <span>\n                    Лицензию на осуществление лотерейной деятельности могут\n                    получить:\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    юридические лица, зарегистрированные в Узбекистане;\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    компании, соответствующие требованиям по уставному капиталу,\n                    технической оснащённости и программному обеспечению;\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    организации, предоставляющие гарантии по выплате выигрышей.\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>Основные этапы получения лицензии:</span>\n                  <br></br>\n                  <span>Подача заявления в уполномоченный орган</span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    Через Единый портал интерактивных государственных услуг\n                    (my.gov.uz);\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    Либо напрямую в Агентство по развитию электронного\n                    правительства и цифровой экономики при Министерстве цифровых\n                    технологий.\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>Предоставление пакета документов</span>\n                  <br></br>\n                  <br></br>\n                  <span>Учредительные документы;</span>\n                  <br></br>\n                  <br></br>\n                  <span>Бизнес-план;</span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    Документы, подтверждающие наличие технических средств и\n                    систем учёта;\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>Проект регламента проведения лотереи.</span>\n                  <br></br>\n                  <br></br>\n                  <span>Экспертиза и проверка</span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    Уполномоченные органы проводят анализ представленных\n                    материалов, включая программное обеспечение, обеспечивающее\n                    прозрачность и защиту данных игроков.\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>Получение лицензии</span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    При положительном заключении лицензия выдается сроком на 5\n                    лет;\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    Регистрация лотерейного продукта в государственном реестре\n                    обязательна.\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>Требования к деятельности</span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    Проведение лотерей допускается только в электронной форме (в\n                    онлайн-режиме);\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    Применение сертифицированных ГСЧ (генераторов случайных\n                    чисел);\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    Предоставление регулярной отчётности в налоговые и\n                    регулирующие органы.\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>Дополнительные положения:</span>\n                  <br></br>\n                  <span>\n                    Контроль за деятельностью лотерейных операторов\n                    осуществляется в режиме онлайн в рамках единой системы\n                    мониторинга.\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    За нарушение установленных правил предусмотрена\n                    административная и уголовная ответственность, включая отзыв\n                    лицензии.\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    📌 Важно: Только лицензированные компании имеют право\n                    распространять лотерейные билеты, принимать участие в\n                    организованных розыгрышах и рекламировать лотерейные\n                    продукты.\n                  </span>\n                  <br></br>\n                  <br></br>\n                  <span>\n                    📥 Подать заявку на получение лицензии и ознакомиться с\n                    полным текстом Указа № УП-68 можно на сайте my.gov.uz.\n                  </span>\n                </span>\n              </Fragment>\n            )}\n          </span>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nContentList1.defaultProps = {\n  text: undefined,\n}\n\nContentList1.propTypes = {\n  text: PropTypes.element,\n}\n\nexport default ContentList1\n"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EAAIC,QAAQ,KAAQ,OAAO,CAIvC,MAAO,qBAAqB,QAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAE5B,KAAM,CAAAC,YAAY,CAAIC,KAAK,EAAK,KAAAC,WAAA,CAC9B,mBACEL,IAAA,QAAKM,SAAS,CAAC,6CAA6C,CAAAC,QAAA,cAC1DP,IAAA,QAAKM,SAAS,CAAC,+CAA+C,CAAAC,QAAA,cAC5DP,IAAA,QAAKM,SAAS,CAAC,uCAAuC,CAAAC,QAAA,cACpDP,IAAA,SAAAO,QAAA,EAAAF,WAAA,CACGD,KAAK,CAACI,IAAI,UAAAH,WAAA,UAAAA,WAAA,cACTL,IAAA,CAACF,QAAQ,EAAAS,QAAA,cACPL,KAAA,SAAMI,SAAS,CAAC,sBAAsB,CAAAC,QAAA,eACpCP,IAAA,SAAAO,QAAA,CAAM,uSAEN,CAAM,CAAC,cACPP,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM,8kDAON,CAAM,CAAC,cACPP,IAAA,QAAQ,CAAC,cACTA,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM,sJAA4B,CAAM,CAAC,cACzCP,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM,qWAGN,CAAM,CAAC,cACPP,IAAA,QAAQ,CAAC,cACTA,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM,sRAEN,CAAM,CAAC,cACPP,IAAA,QAAQ,CAAC,cACTA,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM,umBAGN,CAAM,CAAC,cACPP,IAAA,QAAQ,CAAC,cACTA,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM,iUAEN,CAAM,CAAC,cACPP,IAAA,QAAQ,CAAC,cACTA,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM,0LAAkC,CAAM,CAAC,cAC/CP,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM,wNAAuC,CAAM,CAAC,cACpDP,IAAA,QAAQ,CAAC,cACTA,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM,gUAGN,CAAM,CAAC,cACPP,IAAA,QAAQ,CAAC,cACTA,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM,ypBAIN,CAAM,CAAC,cACPP,IAAA,QAAQ,CAAC,cACTA,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM,wLAAgC,CAAM,CAAC,cAC7CP,IAAA,QAAQ,CAAC,cACTA,IAAA,QAAQ,CAAC,cACTA,IAAA,SAAAO,QAAA,CAAM